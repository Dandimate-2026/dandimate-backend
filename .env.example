# MySQL (로컬·개발용 URL: useSSL=false라 allowPublicKeyRetrieval=true가 필요하다. 운영은 TLS를 켠다.)
MYSQL_URL=jdbc:mysql://localhost:3306/durooduroo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
JPA_DDL_AUTO=update

# OpenAI STT
OPENAI_API_KEY=replace-with-openai-key
OPENAI_STT_MODEL=gpt-transcribe
# openai 또는 fake (local 프로필 기본값은 fake)
STT_PROVIDER=openai
# 되묻기·장면 카드·엮기·답가: rule(기본) 또는 openai. openai면 텍스트 모델 이름이 필요하다.
AI_PROVIDER=rule
OPENAI_TEXT_MODEL=

# Storage: local or s3
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=uploads
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=replace-with-bucket
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MinIO local example (STORAGE_TYPE=s3로 바꿀 때 사용)
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_S3_ENDPOINT=http://localhost:9000

# 운영에서는 데모 마감을 끈다
DEMO_ENABLED=false

# 로컬 저장소 사진 URL 서명 키 (32자 이상 무작위 문자열)
MEDIA_SIGNING_SECRET=

# 운영 체크: DEMO_ENABLED=false, JPA_DDL_AUTO=validate, TLS DB URL. README "운영 배포" 참고.
SWAGGER_ENABLED=true

# Kakao OAuth: 실제 값은 AWS 서버/Secrets Manager에 설정한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
# 프론트엔드 origin (경로/끝 슬래시 제외): 로그인 성공 이동 및 CORS 허용 출처
APP_FRONTEND_URL=https://app.example.com
# HTTPS 운영 기본 true. 개인 HTTP 개발 서버에서만 false.
SESSION_COOKIE_SECURE=true
