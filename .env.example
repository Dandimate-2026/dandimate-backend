# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/durooduroo?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=utf8mb4
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
JPA_DDL_AUTO=update

# OpenAI STT
OPENAI_API_KEY=replace-with-openai-key
OPENAI_STT_MODEL=gpt-transcribe
# openai 또는 fake (local 프로필 기본값은 fake)
STT_PROVIDER=openai

# Storage: local or s3
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=uploads
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=replace-with-bucket
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MinIO local example (STORAGE_TYPE=s3로 바꿀 때 사용)
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_S3_ENDPOINT=http://localhost:9000

# 운영에서는 데모 마감을 끈다
DEMO_ENABLED=false

# 로컬 저장소 사진 URL 서명 키 (32자 이상 무작위 문자열)
MEDIA_SIGNING_SECRET=
