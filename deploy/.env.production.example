# 운영 서버 /home/ubuntu/durooduroo/.env 의 예시. 이 파일을 복사해 값을 채우고, Git에는 절대 올리지 않는다.
# 값에 따옴표를 붙이지 않는다(docker compose가 그대로 읽는다).

# MySQL (같은 서버의 mysql 컨테이너. 연결 주소는 docker-compose.prod.yml이 정한다)
MYSQL_USERNAME=durooduroo
MYSQL_PASSWORD=replace-with-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
JPA_DDL_AUTO=validate

# 사진·음성 저장 (S3). EC2에 IAM 역할을 붙이면 접근 키를 비워 둔다.
STORAGE_TYPE=s3
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=replace-with-bucket
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DB 백업을 올릴 버킷 (비우면 AWS_S3_BUCKET 의 backups/mysql/ 아래에 올린다)
BACKUP_S3_BUCKET=

# OpenAI (서버 비밀값)
OPENAI_API_KEY=replace-with-openai-key
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-5.4-mini
STT_PROVIDER=openai
AI_PROVIDER=openai
AI_SEND_PHOTOS=true

# 카카오 로그인 (서버 비밀값). Redirect URI는 카카오 개발자 콘솔에 등록한 값과 완전히 같아야 한다.
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_REDIRECT_URI=https://your-domain/login/oauth2/code/kakao
# 로그인 후 돌아갈 프론트 origin (끝 슬래시 없이). 세션 쿠키가 SameSite=Lax라 프론트와 백엔드는 같은 사이트여야 한다.
APP_FRONTEND_URL=https://your-domain
SESSION_COOKIE_SECURE=true

# 운영에서는 데모 기능과 체험 페이지를 끈다
DEMO_ENABLED=false
SWAGGER_ENABLED=false

# 고정 초대 링크 AES-GCM 암호화 키. 서버에서 무작위 생성하고 영구 보관(교체 시 기존 링크 조회 불가).
INVITE_TOKEN_SECRET=replace-with-random-32-byte-secret
